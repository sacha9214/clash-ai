@@ -84,6 +84,15 @@ class CRDetectionLoss(v8DetectionLoss):
     return loss.sum() * batch_size, loss.detach()  # loss(box, cls, dfl)
 
 class CRTaskAlignedAssigner(TaskAlignedAssigner):
+  def forward(self, *args):
+    """clash-ai : sur MPS (Mac), l'indexation par masque booléen donne des tailles
+    incohérentes (bug PyTorch) -> l'assignation se fait sur CPU."""
+    dev = args[0].device
+    if dev.type != "mps":
+      return super().forward(*args)
+    out = super().forward(*[a.detach().cpu() if hasattr(a, "cpu") else a for a in args])
+    return tuple(o.to(dev) if hasattr(o, "to") else o for o in out)
+
 
   def get_targets(self, gt_labels, gt_bboxes, target_gt_idx, fg_mask):
     """
